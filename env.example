# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Optional: proxy for Telegram Bot API (HTTP/HTTPS or SOCKS5)
# TELEGRAM_PROXY_URL=http://127.0.0.1:8080
# Optional: custom Bot API base URL (reverse proxy / local Bot API server)
# TELEGRAM_API_URL=https://tg-api.example.com

# Pinecone settings
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_ENVIRONMENT=us-east-1
PINECONE_INDEX_NAME=telegram-bot-memory
# PINECONE_PROXY_URL=http://user:pass@proxy.example.com:8080    # опционально: HTTP-прокси для SDK

# Embedding model (sentence-transformers)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Similarity threshold for duplicate filtering (0.0 - 1.0)
SIMILARITY_THRESHOLD=0.85

# ---------------------------------------------------------------------------
# LLM provider (AITUNNEL — OpenAI-compatible)
# https://api.aitunnel.ru/v1
# ---------------------------------------------------------------------------
LLM_BASE_URL=https://api.aitunnel.ru/v1
LLM_API_KEY=sk-aitunnel-your_key_here
LLM_MODEL=openai/gpt-5-nano
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.7
